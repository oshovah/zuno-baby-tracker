{
  "name": "zuno-baby-tracker",
  "description": "Self-hosted, end-to-end encrypted newborn tracker for two parents (vanilla JS PWA + PHP/SQLite API)",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "repository": "github:oshovah/zuno-baby-tracker",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"php -S 127.0.0.1:8788 scripts/dev-router.php\" \"vite\"",
    "build": "vite build",
    "test": "php api/tests/run.php && node --test src/tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "preview": "php -S 127.0.0.1:8081 scripts/preview-router.php",
    "screenshots": "node scripts/make-screenshots.mjs",
    "spike": "vite --config scripts/spike/vite.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}

{
  "name": "zuno-baby-tracker",
  "description": "Self-hosted, end-to-end encrypted newborn tracker for two parents (vanilla JS PWA + PHP/SQLite API)",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "repository": "github:oshovah/zuno-baby-tracker",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"php -S 127.0.0.1:8788 scripts/dev-router.php\" \"vite\"",
    "build": "vite build",
    "test": "php api/tests/run.php && node --test src/tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:beta": "node scripts/deploy.mjs --env .env.beta",
    "deploy:basemap": "node scripts/deploy.mjs --basemap",
    "deploy:basemap:beta": "node scripts/deploy.mjs --basemap --env .env.beta",
    "preview": "php -S 127.0.0.1:8081 scripts/preview-router.php",
    "screenshots": "node scripts/make-screenshots.mjs",
    "e2e:offline": "node scripts/e2e-offline.mjs",
    "map:data": "node scripts/map-data.mjs",
    "map:basemap": "node scripts/map-basemap.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0"
  }
}

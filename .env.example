# Baby tracker — packaging & deploy configuration.
# Copy this file to ".env" and fill in your server details. ".env" is gitignored;
# never commit real credentials.
#
# Format: KEY=VALUE, one per line. Only full-line "#" comments are supported —
# everything after "=" is the value (so a "#" inside a password is fine).
# Optional surrounding single/double quotes around the value are stripped.
# Read by scripts/deploy.mjs (DEPLOY_*) and scripts/package.mjs (APP_PASSWORD,
# DEPLOY_DB_PATH, PRIVATE_ART_FAMILY).
#
# Accounts, families and keys are managed IN THE APP (register on first visit;
# family name + family password or the recovery code lets the partner join).
# Entries are end-to-end encrypted: the server and this file hold no key.

# ONLY for the migration release from the old one-password version: the old
# shared password. package.mjs bcrypt-hashes it into the deployed config as the
# "legacy adoption gate" — the first registration must repeat it to adopt the
# existing entries (otherwise a stranger could seal your history under their
# key). Delete the line after the cutover and re-package.
APP_PASSWORD=

# Optional: where the SQLite database lives ON THE SERVER, written into the
# packaged api/config.php. Unset = <docroot>/data/baby.db (kept off the web by
# two .htaccess rules). A place above the docroot does not depend on .htaccess
# at all: an absolute server path, or "../<dir>/baby.db" relative to the
# docroot (e.g. ../baby-data/baby.db — no need to know the absolute path).
# Order matters: move baby.db, baby.db-wal and baby.db-shm to the new place
# FIRST (at a quiet moment), THEN set this and deploy — the API creates an
# empty database at a missing path and every phone would log out.
DEPLOY_DB_PATH=

# Optional: private artwork. The repo ships its own icon set (public/img/,
# drawn by scripts/make-icons.mjs). Pictures you may use at home but not
# publish go into the gitignored private-art/ folder under the same names
# (favicon.png, apple-touch-icon.png, icon-192.png, icon-512.png, zuno.png);
# name your family here and ONLY its members get them — through the API,
# behind the login (api/lib/art.php). Everyone else sees the public icons.
# Unset = off, private-art/ is not even packaged.
PRIVATE_ART_FAMILY=

# How to upload the packaged deploy/ folder. One of: rsync | sftp | ftp | local
# rsync/sftp go over SSH and authenticate with keys/agent (no passwords).
# ftp uses DEPLOY_PASSWORD and requires FTPS (TLS) unless FTP_INSECURE=1.
# local simply copies deploy/ to DEPLOY_PATH on this machine (pipeline testing).
DEPLOY_METHOD=rsync

# Server hostname (rsync/sftp/ftp; unused for "local").
DEPLOY_HOST=example.com

# Optional port. Defaults: 22 for rsync/sftp, 21 for ftp.
DEPLOY_PORT=

# Login user on the server (rsync/sftp/ftp).
DEPLOY_USER=username

# Password — used by the "ftp" method only (rsync/sftp use SSH keys).
# It is never passed on a command line; it goes into a chmod-600 temp curl
# config file that is deleted right after the upload.
DEPLOY_PASSWORD=

# Target directory on the server: the web root or a subdirectory of it
# (e.g. /htdocs/baby). For ftp this is ALWAYS relative to the FTP login
# (home) directory — a leading "/" does NOT make it filesystem-absolute.
# For "local" it is a directory on this machine (must be outside this project).
# Re-deploys NEVER touch the remote data/ directory or any *.db file.
DEPLOY_PATH=/htdocs/baby

# Optional: public URL of the deployed app, e.g. https://baby.example.com
# After uploading, deploy.mjs requests <DEPLOY_URL>/api/me and reports the
# HTTP status as a health check (that endpoint is public by design). It is
# also the first request after an upload, i.e. the one that runs a pending
# database migration.
DEPLOY_URL=

# Set to 1 to allow PLAIN unencrypted FTP when the server offers no TLS.
# Credentials travel in cleartext — avoid if at all possible.
# Default (empty): FTPS is required (curl --ssl-reqd).
FTP_INSECURE=

# Set to 1 to make rsync delete remote files that no longer exist locally
# (rsync method only; the remote data/ directory is always excluded from
# deletion). Default (empty): never delete anything remotely.
DEPLOY_DELETE=
